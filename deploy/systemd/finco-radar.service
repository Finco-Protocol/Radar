[Unit]
Description=FINCO Radar Standalone Web/API Service (Option B candidate)
After=network.target

[Service]
Type=simple
User=finco
Group=finco
WorkingDirectory=/opt/finco-radar
EnvironmentFile=/etc/finco-radar/radar.env
ExecStart=/opt/finco-radar/.venv/bin/uvicorn radar_service.app:app --host 127.0.0.1 --port 8010 --workers 2
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/finco-radar

[Install]
WantedBy=multi-user.target
