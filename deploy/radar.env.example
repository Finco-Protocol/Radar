# Standalone FINCO Radar runtime environment template (SECRET NAMES ONLY — never commit real values)
# Copy privately to /etc/finco/radar.env (mode 0600, owned by finco)

FINCO_ENV=production
FINCO_YIELD_ENABLED=1

# Private loopback/service channel to FincoProtocol Model host auth/entitlement authority
FINCO_MODEL_INTERNAL_AUTH_URL=http://127.0.0.1:8000
FINCO_INTERNAL_AUTH_INTROSPECT_TOKEN=

# Stable per-service CSRF HMAC secret (REQUIRED >= 16 chars in staging/production; NEVER Model's FINCO_SECRET_KEY)
FINCO_RADAR_CSRF_SECRET=

# Persisted local Radar/Crypto/Yield state stores (never shared with Model DB)
R_LIVE_SNAPSHOT_DB_PATH=/var/lib/finco/radar/r_live_snapshots.db
FINCO_VENUE_DB_PATH=/var/lib/finco/radar/venues_market_observations.db
FINCO_YIELD_HISTORY_PATH=/var/lib/finco/yield/yield_history.jsonl
FINCO_RADAR_ALERTS_DB_PATH=/var/lib/finco/radar/radar_crypto_alerts.db
